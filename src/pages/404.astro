---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Glow } from '@components/Glow.tsx'

const sections = [
  { name: 'Documentation', href: '/docs', description: 'Guides and references for every Altitude product.' },
  { name: 'Products', href: '/products', description: 'The platform, components and developer tools.' },
  { name: 'Blog', href: '/blog', description: 'Release notes, tutorials and news from the team.' },
];
---

<BaseLayout title="Page not found">
  <div class="relative overflow-hidden bg-black/20 antialiased">
    <div class="container px-4 lg:px-0 mx-auto py-24 sm:py-32">
      <div class="sm:max-w-3xl mx-auto text-center">
        <p class="text-base font-semibold leading-7 text-stone-400">404</p>
        <h1 class="mt-2 text-3xl tracking-tight text-white sm:text-6xl">
          Page not found
        </h1>
        <p class="mt-4 font-light text-lg text-stone-400">
          The page you're looking for doesn't exist or may have moved.
        </p>
      </div>
      <div class="mt-10 flex justify-center">
        <a href="/" class="inline-block rounded-md border border-transparent bg-white text-black px-8 py-3 text-center font-medium">
          Back to home
        </a>
      </div>
      <ul role="list" class="mt-16 grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-3xl mx-auto">
        {sections.map((section) => (
          <li>
            <a
              href={section.href}
              class="group relative block h-full border border-white/10 hover:bg-white/5 rounded-lg p-6 transition-all duration-200"
            >
              <span class="block pr-6 font-semibold text-stone-100">{section.name}</span>
              <span class="mt-2 block text-sm text-stone-400 group-hover:text-stone-300 transition-colors">
                {section.description}
              </span>
              <svg
                class="absolute top-6 right-6 w-5 h-5 text-stone-500 group-hover:text-stone-400 transition-colors"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  fill-rule="evenodd"
                  d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                  clip-rule="evenodd"
                />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <Glow
      variant="bottom"
      className="-z-1 animate-appear-zoom opacity-0 delay-1000"
      client:only="react"
    />
  </div>
</BaseLayout>
